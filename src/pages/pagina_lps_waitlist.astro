---
import PageHeader from '../components/PageHeader.astro';
import Timeline from '../components/Timeline.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { documentBySlug } from '../lib/documents';
import Section01 from '../components/pages/pagina_lps_waitlist/Section01.astro';
import Section02 from '../components/pages/pagina_lps_waitlist/Section02.astro';
import Section03 from '../components/pages/pagina_lps_waitlist/Section03.astro';
import Section04 from '../components/pages/pagina_lps_waitlist/Section04.astro';
import Section05 from '../components/pages/pagina_lps_waitlist/Section05.astro';
import '../styles/pages/pagina_lps_waitlist.css';

const document = documentBySlug("pagina_lps_waitlist");
---

<BaseLayout document={document}>
  <PageHeader eyebrow={""} title={"Quatro landings — um tema, um foco"} description={"Destino dos e-mails da campanha Waitlist → Cadastro. Evergreen: nenhum jogo da semana. A prova, quando existe, é método ou caso encerrado. Cadastro só onde o job é converter."} />
  <section class="shell-container mb-4" aria-label="Linha do tempo da campanha">
    <Timeline items={[{"label":"LP 1","title":"Expectativa","description":"Confirma o que chega pela lista."},{"label":"LP 2","title":"Método","description":"Expõe a gramática completa de leitura."},{"label":"LP 3","title":"Empresa","description":"Apresenta princípios e limites."},{"label":"LP 4","title":"Perfil","description":"Captura a finalidade de uso."}]} />
  </section>
  <article class="astro-document">
    <div class="wrap">
    <Section01 />
    <Section02 />
    <Section03 />
    <Section04 />
    <Section05 />
    </div>
  </article>
</BaseLayout>
