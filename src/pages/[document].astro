---
import LegacyDocument from '../components/LegacyDocument.astro';
import {
  documents,
  extractLegacyDocument,
  type DocumentDefinition,
} from '../lib/documents';
import BaseLayout from '../layouts/BaseLayout.astro';

export function getStaticPaths() {
  return documents.slice(1).map((document) => ({
    params: {
      document: document.slug,
    },
    props: {
      document,
    },
  }));
}

interface Props {
  document: DocumentDefinition;
}

const { document } = Astro.props;
const legacyDocument = extractLegacyDocument(document.source);
---

<BaseLayout document={document} legacyStyles={legacyDocument.styles}>
  <LegacyDocument html={legacyDocument.body} />
</BaseLayout>
