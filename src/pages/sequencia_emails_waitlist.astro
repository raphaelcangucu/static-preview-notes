---
import PageHeader from '../components/PageHeader.astro';
import Timeline from '../components/Timeline.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { documentBySlug } from '../lib/documents';
import Section01 from '../components/pages/sequencia_emails_waitlist/Section01.astro';
import Section02 from '../components/pages/sequencia_emails_waitlist/Section02.astro';
import '../styles/pages/sequencia_emails_waitlist.css';

const document = documentBySlug("sequencia_emails_waitlist");
---

<BaseLayout document={document}>
  <PageHeader
    eyebrow={""}
    title={"Campanha Waitlist → Cadastro — comportamental"}
    description={"Evergreen, no máximo três mensagens e recalculada por comportamento. O Bloco 8 roda em paralelo, tem prioridade e não é duplicado aqui."}
  />
  <section class="shell-container mb-4" aria-label="Linha do tempo da campanha">
    <Timeline
      items={[
        {
          label: 'E1',
          title: 'Orientação',
          description: 'Apresenta apenas a próxima superfície útil.',
        },
        {
          label: 'E2',
          title: 'Prova institucional',
          description: 'Mostra o que a conta grátis abre além do e-mail.',
        },
        {
          label: 'E3',
          title: 'Decisão / recuperação',
          description: 'Leva ao artigo ou retoma conteúdo e cadastro.',
        },
      ]}
    />
  </section>
  <article class="astro-document">
    <div class="wrap">
    <Section01 />
    <Section02 />
    </div>
  </article>
</BaseLayout>
