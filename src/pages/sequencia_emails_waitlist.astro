---
import PageHeader from '../components/PageHeader.astro';
import Timeline from '../components/Timeline.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { documentBySlug } from '../lib/documents';
import Section01 from '../components/pages/sequencia_emails_waitlist/Section01.astro';
import Section02 from '../components/pages/sequencia_emails_waitlist/Section02.astro';
import '../styles/pages/sequencia_emails_waitlist.css';

const document = documentBySlug("sequencia_emails_waitlist");
---

<BaseLayout document={document}>
  <PageHeader
    eyebrow={""}
    title={"Campanha Waitlist → Cadastro — institucional e comportamental"}
    description={"Três e-mails institucionais coordenados com a primeira análise esportiva. As campanhas esportivas continuam separadas, têm prioridade e não são duplicadas nesta trilha."}
  />
  <section class="shell-container mb-4" aria-label="Linha do tempo da campanha">
    <Timeline
      items={[
        {
          label: 'E1',
          title: 'Acolhimento institucional',
          description: 'Confirma a escolha e apresenta a Macro Markets.',
        },
        {
          label: 'E2',
          title: 'Propósito e método',
          description: 'Explica por que existimos e como analisamos.',
        },
        {
          label: 'E3',
          title: 'Conversão comportamental',
          description: 'Só fica elegível após a primeira análise esportiva.',
        },
      ]}
    />
  </section>
  <article class="astro-document">
    <div class="wrap">
    <Section01 />
    <Section02 />
    </div>
  </article>
</BaseLayout>
