---
import PageHeader from '../components/PageHeader.astro';
import Timeline from '../components/Timeline.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { documentBySlug } from '../lib/documents';
import Section01 from '../components/pages/sequencia_emails_waitlist/Section01.astro';
import Section02 from '../components/pages/sequencia_emails_waitlist/Section02.astro';
import '../styles/pages/sequencia_emails_waitlist.css';

const document = documentBySlug("sequencia_emails_waitlist");
---

<BaseLayout document={document}>
  <PageHeader eyebrow={""} title={"Campanha Waitlist → Cadastro — Bloco 11"} description={"Evergreen. O e-mail é o gancho; a landing é o job. Nenhuma peça desta campanha cita jogo, placar ou rodada — isso é Bloco 8, em paralelo. Merge: {{first_name|aí}} · {{league}}."} />
  <section class="mx-auto mb-8 w-[min(100%-2rem,1320px)]" aria-label="Linha do tempo da campanha">
    <Timeline items={[{"label":"D0","title":"Expectativa","description":"O que a lista entrega, sem pedir uma conta."},{"label":"D+2","title":"Método","description":"Como a Macro Markets lê um jogo."},{"label":"D+4","title":"Empresa","description":"Quem somos e o que recusamos fazer."},{"label":"Evento","title":"Perfil","description":"Uma pergunta para personalizar a ênfase."}]} />
  </section>
  <article class="astro-document">
    <div class="wrap">
    <Section01 />
    <Section02 />
    </div>
  </article>
</BaseLayout>
