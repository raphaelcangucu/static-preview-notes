---
import PageHeader from '../components/PageHeader.astro';
import Timeline from '../components/Timeline.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { documentBySlug } from '../lib/documents';
import Section01 from '../components/pages/sequencia_emails/Section01.astro';
import Section02 from '../components/pages/sequencia_emails/Section02.astro';
import '../styles/pages/sequencia_emails.css';

const document = documentBySlug("sequencia_emails");
---

<BaseLayout document={document}>
  <PageHeader
    eyebrow={"Campanha por rodada · Waitlist → Cadastro"}
    title={"Quatro eventos. Quinze copies. Valor antes do CTA."}
    description={"A cadência acompanha o calendário real de cada rodada. Assuntos, previews e corpos usam o mesmo payload editorial; nenhuma variante depende de dia, horário ou confronto fixo."}
  />
  <section class="shell-container mb-4" aria-label="Linha do tempo da campanha">
    <Timeline items={[
      {"label":"E1","title":"Pré-rodada","description":"Antes do primeiro bloco real."},
      {"label":"E2","title":"Primeiro bloco","description":"Quando o primeiro bloco principal começa."},
      {"label":"E3","title":"Bloco final","description":"Quando o bloco principal final começa."},
      {"label":"E4","title":"Pós-rodada","description":"Após o último jogo real, com evidências confirmadas."}
    ]} />
  </section>
  <article class="astro-document">
    <div class="wrap">
    <Section01 />
    <Section02 />
    </div>
  </article>
</BaseLayout>
