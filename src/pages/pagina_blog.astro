---
import PageHeader from '../components/PageHeader.astro';
import PremiumGate from '../components/PremiumGate.astro';
import ScenarioTabs from '../components/ScenarioTabs.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { documentBySlug } from '../lib/documents';
import Section01 from '../components/pages/pagina_blog/Section01.astro';
import Section02 from '../components/pages/pagina_blog/Section02.astro';
import Section03 from '../components/pages/pagina_blog/Section03.astro';
import Section04 from '../components/pages/pagina_blog/Section04.astro';
import '../styles/pages/pagina_blog.css';

const document = documentBySlug("pagina_blog");
---

<BaseLayout document={document}>
  <PageHeader eyebrow={"Macro Markets · funil de conteúdo · peça 4"} title={"Blog / seção de conteúdo — índice e artigo aberto nos 3 cenários"} description={"O blog é a porta de entrada do funil: é ele que alimenta o Hub do Campeonato e a Página da Rodada. Aqui estão as duas vistas — a grade de artigos e o artigo aberto — mostradas nos três estados de acesso, com o mesmo vocabulário visual das outras páginas."} />
  <div id="cenario-1"></div><div id="cenario-2"></div><div id="cenario-3"></div>
  <ScenarioTabs />
  <div class="shell-container mb-4">
    <PremiumGate title="Camada Premium" description="Âmbar identifica exclusivamente conteúdo pago; rótulos permanecem legíveis e somente valores são velados.">
      <p class="m-0 text-sm text-slate-300">Modelo, delta e cenários condicionais aparecem no canvas escuro quando o acesso está ativo.</p>
    </PremiumGate>
  </div>
  <article class="astro-document">
    <div class="wrap">
    <Section01 />
    <Section02 />
    <Section03 />
    <Section04 />
    </div>
  </article>
</BaseLayout>
