---
import SiteNavigation from '../components/SiteNavigation.astro';
import StateLegend from '../components/StateLegend.astro';
import type { DocumentDefinition } from '../lib/documents';
import '../styles/global.css';

interface Props {
  document: DocumentDefinition;
}

const { document } = Astro.props;
---

<!doctype html>
<html lang="pt-BR" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="description" content={document.description} />
    <meta name="theme-color" content="#111318" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>{document.title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Pular para o conteúdo</a>
    <div class="site-shell" data-site-shell>
      <SiteNavigation currentDocument={document} />
      <div class="shell-container py-3">
        <StateLegend />
      </div>
      <main id="main-content" tabindex="-1">
        <slot />
      </main>
      <footer class="mt-10 border-t border-[var(--border-subtle)] bg-[var(--canvas-modal)]">
        <div class="shell-container flex flex-col gap-2 py-8 text-sm md:flex-row md:items-center md:justify-between">
          <p class="m-0 font-extrabold tracking-tight text-[var(--text-title)]">
            Macro Markets · Preview Notes
          </p>
          <p class="m-0 max-w-3xl text-[var(--text-muted)]">
            Documento interno com dados ilustrativos. Conteúdo bloqueado mantém o rótulo legível e vela apenas o valor.
          </p>
        </div>
      </footer>
    </div>
  </body>
</html>
