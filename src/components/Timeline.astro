---
interface TimelineItem {
  label: string;
  title: string;
  description: string;
}

interface Props {
  items: TimelineItem[];
}

const { items } = Astro.props as Props;
---

<ol class="m-0 grid list-none gap-3 p-0 md:grid-cols-2 xl:grid-cols-4" data-timeline>
  {
    items.map((item, index) => (
      <li class="relative rounded-[var(--radius-card)] border border-[var(--surface-accent)] bg-[var(--surface-raised)] p-4">
        <span class="mb-4 inline-grid size-8 place-items-center rounded-full bg-[var(--color-primary)] text-xs font-extrabold text-[var(--color-primary-contrast)]">
          {index + 1}
        </span>
        <p class="m-0 text-[0.64rem] font-extrabold uppercase tracking-[0.12em] text-[var(--color-primary)]">
          {item.label}
        </p>
        <h3 class="mb-0 mt-1 text-base font-extrabold text-[var(--text-title)]">{item.title}</h3>
        <p class="mb-0 mt-2 text-sm leading-6 text-[var(--text-muted)]">{item.description}</p>
      </li>
    ))
  }
</ol>
