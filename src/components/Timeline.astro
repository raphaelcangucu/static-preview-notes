---
interface TimelineItem {
  label: string;
  title: string;
  description: string;
}

interface Props {
  items: TimelineItem[];
}

const { items } = Astro.props as Props;
---

<ol class="m-0 grid list-none gap-3 p-0 md:grid-cols-2 xl:grid-cols-4">
  {
    items.map((item, index) => (
      <li class="relative rounded-xl border border-slate-300 bg-white p-4 shadow-sm">
        <span class="mb-3 inline-grid size-8 place-items-center rounded-full bg-blue-700 text-sm font-black text-white">
          {index + 1}
        </span>
        <p class="m-0 text-xs font-black uppercase tracking-wider text-blue-800">
          {item.label}
        </p>
        <h3 class="mb-0 mt-1 text-base font-black text-slate-950">{item.title}</h3>
        <p class="mb-0 mt-2 text-sm leading-6 text-slate-600">{item.description}</p>
      </li>
    ))
  }
</ol>
