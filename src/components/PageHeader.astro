---
interface Props {
  eyebrow?: string;
  title: string;
  description: string;
}

const { eyebrow, title, description } = Astro.props;
---

<header class="mx-auto w-[min(100%-2rem,1320px)] py-8 md:py-12">
  <div class="rounded-2xl bg-gradient-to-br from-blue-700 to-emerald-700 px-6 py-8 text-white shadow-lg md:px-10">
    {eyebrow && (
      <p class="m-0 text-xs font-black uppercase tracking-[0.18em] text-blue-100">
        {eyebrow}
      </p>
    )}
    <h1 class="mb-0 mt-2 max-w-5xl text-3xl font-black tracking-tight text-white md:text-5xl">
      {title}
    </h1>
    <p class="mb-0 mt-4 max-w-4xl text-base leading-7 text-blue-50 md:text-lg">
      {description}
    </p>
  </div>
</header>
