---
interface Props {
  eyebrow?: string;
  title: string;
  description: string;
}

const { eyebrow, title, description } = Astro.props;
---

<header class="shell-container py-3 md:py-5" data-page-header>
  <div class="grid gap-4 rounded-[var(--radius-panel)] border border-[var(--surface-accent)] bg-[var(--surface-raised)] p-4 shadow-[var(--shadow-card)] md:p-6">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div class="min-w-0">
        <p class="m-0 text-[0.66rem] font-extrabold uppercase tracking-[0.14em] text-[var(--color-primary)]">
          {eyebrow || 'Macro Markets · Project workspace'}
        </p>
        <h1 class="mb-0 mt-2 max-w-5xl text-[clamp(1.65rem,4vw,2.8rem)] font-extrabold leading-[1.05] tracking-[-0.04em] text-[var(--text-title)]">
          {title}
        </h1>
      </div>
      <span class="inline-flex min-h-9 shrink-0 items-center rounded-full border border-[var(--border-subtle)] bg-[var(--surface)] px-3 text-[0.68rem] font-extrabold uppercase tracking-[0.08em] text-[var(--text-muted)]">
        Documento interno
      </span>
    </div>
    <p class="m-0 max-w-4xl text-sm leading-6 text-[var(--text-muted)] md:text-base md:leading-7">
      {description}
    </p>
    <div class="flex flex-wrap gap-x-5 gap-y-2 border-t border-[var(--border-subtle)] pt-3 text-xs text-[var(--text-hint)]">
      <span><strong class="text-[var(--text-title)]">7</strong> documentos conectados</span>
      <span><strong class="text-[var(--text-title)]">4</strong> estados de acesso</span>
      <span><strong class="text-[var(--text-title)]">2026</strong> sistema visual</span>
    </div>
  </div>
</header>
