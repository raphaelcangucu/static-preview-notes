---
import {
  ROUND_EMAIL_CAMPAIGN,
  ROUND_EMAIL_PAYLOAD_CONTRACT,
} from '../../../lib/roundEmailCampaign';
---

<section
  class="round-campaign-overview"
  data-round-email-campaign
  aria-labelledby="campaign-overview-title"
>
  <div class="campaign-promise">
    <span class="section-kicker">Waitlist → Cadastro</span>
    <h2 id="campaign-overview-title">O valor chega antes do CTA</h2>
    <p>{ROUND_EMAIL_CAMPAIGN.promise}</p>
    <div class="campaign-metric" data-primary-metric>
      <span>Métrica primária</span>
      <code>{ROUND_EMAIL_CAMPAIGN.primaryMetric}</code>
    </div>
  </div>

  <div class="campaign-contract" data-calendar-contract>
    <div class="section-heading">
      <span class="section-kicker">Contrato dinâmico</span>
      <h2>Calendário orientado a eventos</h2>
      <p>Datas recorrentes podem acontecer, mas nunca são premissas do envio.</p>
    </div>
    <ol>
      {ROUND_EMAIL_CAMPAIGN.calendarContract.map((rule) => <li>{rule}</li>)}
    </ol>
  </div>

  <div class="event-cadence" aria-labelledby="event-cadence-title">
    <div class="section-heading">
      <span class="section-kicker">Cadência</span>
      <h2 id="event-cadence-title">Quatro momentos, definidos pela rodada real</h2>
    </div>
    <ol>
      {ROUND_EMAIL_CAMPAIGN.emails.map((email, index) => (
        <li>
          <span>{index + 1}</span>
          <div>
            <strong>{email.id} · {email.title}</strong>
            <p>{email.trigger}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>

  <details class="payload-contract">
    <summary>Contrato editorial de payload</summary>
    <p>
      Assunto, preview e corpo usam o mesmo snapshot. Token ausente, obsoleto ou
      contraditório bloqueia a publicação.
    </p>
    <div class="payload-grid">
      {ROUND_EMAIL_PAYLOAD_CONTRACT.map((group) => (
        <article data-payload-group={group.id}>
          <h3>{group.label}</h3>
          <p>{group.rule}</p>
          <code>{group.keys.join(' · ')}</code>
        </article>
      ))}
    </div>
  </details>

  <div class="experiment-contract">
    <div class="section-heading">
      <span class="section-kicker">Experimento</span>
      <h2>Regras A/B/n</h2>
    </div>
    <ul>
      {ROUND_EMAIL_CAMPAIGN.experimentRules.map((rule) => <li>{rule}</li>)}
    </ul>
  </div>
</section>
