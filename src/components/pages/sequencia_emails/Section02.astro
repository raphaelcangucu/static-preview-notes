---
import { ROUND_EMAIL_CAMPAIGN } from '../../../lib/roundEmailCampaign';
import EmailVariantCard from './EmailVariantCard.astro';
---

<section class="round-email-sequence" aria-labelledby="sequence-title">
  <div class="section-heading sequence-heading">
    <span class="section-kicker">15 copies aprovadas</span>
    <h2 id="sequence-title">Previews comparáveis por evento</h2>
    <p>
      Cada corpo entrega tese, evidência, interpretação e próximo sinal antes de
      um único CTA de aprofundamento.
    </p>
  </div>

  {ROUND_EMAIL_CAMPAIGN.emails.map((email) => (
    <section
      class="round-email-stage"
      data-round-email={email.event}
      data-email-id={email.id}
      data-queue-gate={email.queueGate}
      aria-labelledby={`${email.id}-title`}
    >
      <header class="stage-heading">
        <div>
          <span class="section-kicker">{email.id} · {email.event}</span>
          <h2 id={`${email.id}-title`}>{email.title}</h2>
          <p>{email.trigger}</p>
        </div>
        <div class="stage-purpose">
          <span>Função editorial</span>
          <p>{email.purpose}</p>
        </div>
      </header>

      {email.queueGate === 'confirmed_results_and_evidence' && (
        <div class="queue-warning" role="note">
          <strong>Bloqueio obrigatório</strong>
          Nenhuma variante pode ser enfileirada antes de placares, movimentos na
          tabela e evidências receberem status <code>confirmed</code>.
        </div>
      )}

      <div class="variant-grid">
        {email.variants.map((variant) => (
          <EmailVariantCard variant={variant} />
        ))}
      </div>
    </section>
  ))}
</section>
