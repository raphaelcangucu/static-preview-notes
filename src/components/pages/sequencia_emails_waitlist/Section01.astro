---
import {
  DESTINATIONS,
  FREQUENCY_CAP,
  JOURNEY_PRIORITY,
  RECENCY_DAYS,
  trackedDestination,
  type JourneyState,
} from '../../../lib/waitlistCampaign';

const hubOverview = trackedDestination(
  DESTINATIONS.hub,
  'e1_discovery',
);
const hubDeepening = trackedDestination(
  DESTINATIONS.hub,
  'e1_deepening',
);
const roundOverview = trackedDestination(
  DESTINATIONS.round,
  'e1_deepening',
);
const institutionalComparison = trackedDestination(
  DESTINATIONS.institutionalLp.replace(
    'lp-exclusive-hero',
    'lp-exclusive-comparison',
  ),
  'e2_discovery',
);
const institutionalDemo = trackedDestination(
  DESTINATIONS.institutionalLp.replace(
    'lp-exclusive-hero',
    'lp-exclusive-demo',
  ),
  'e2_deepening',
  { returnUrl: '{{return_url|url_encode}}' },
);
const methodologyArticle = trackedDestination(
  DESTINATIONS.blog,
  'e3_discovery',
);
const registrationWithRecentReturn = trackedDestination(
  DESTINATIONS.registration,
  'e3_deepening',
  { returnUrl: '{{return_url|url_encode}}' },
);
const registrationWithRoundReturn = trackedDestination(
  DESTINATIONS.registration,
  'e3_deepening',
  { returnUrl: encodeURIComponent(DESTINATIONS.round) },
);
const gateRecovery = trackedDestination(
  DESTINATIONS.registration,
  'gate_recovery_1',
  { returnUrl: '{{return_url|url_encode}}' },
);
const registrationRecovery = trackedDestination(
  DESTINATIONS.registration,
  'registration_recovery_1',
  {
    returnUrl: '{{return_url|url_encode}}',
    resumeToken: '{{resume_token|url_encode}}',
  },
);

type JourneyDestination = {
  stage: string;
  label: string;
  href: string;
};

const matrixRows: Array<{
  state: JourneyState;
  label: string;
  treatment: string;
  message: string;
  destinations: JourneyDestination[];
  suppression: string;
}> = [
  {
    state: 'registration_abandonment',
    label: 'Abandonou cadastro',
    treatment: 'registration_recovery',
    message: '1h → retomar cadastro; lembrete opcional em 24h se houver slot.',
    destinations: [
      {
        stage: 'recovery',
        label: 'Sessão de cadastro retomável',
        href: registrationRecovery,
      },
    ],
    suppression: 'Sequência regular e recuperação de gate.',
  },
  {
    state: 'gate_intent',
    label: 'Tocou gate',
    treatment: 'gate_recovery',
    message:
      '2h → cadastro; lembrete único 72 horas após a primeira recuperação, se houver slot.',
    destinations: [
      {
        stage: 'recovery',
        label: 'Cadastro com retorno exato ao teaser',
        href: gateRecovery,
      },
    ],
    suppression: 'Toda a sequência regular.',
  },
  {
    state: 'viewed_2_plus',
    label: 'Viu 2+',
    treatment: 'deepening',
    message: 'E1 suprimido; E2 prova o benefício; E3 leva ao cadastro direto.',
    destinations: [
      {
        stage: 'e2',
        label: 'E2 · Recorte curto na LP',
        href: institutionalDemo,
      },
      {
        stage: 'e3',
        label: 'E3 · Cadastro com retorno à superfície recente',
        href: registrationWithRecentReturn,
      },
    ],
    suppression: 'Descoberta e E1.',
  },
  {
    state: 'viewed_round',
    label: 'Viu Rodada',
    treatment: 'deepening',
    message: 'E1 suprimido; E2 → LP; E3 → artigo ou cadastro com retorno à Rodada.',
    destinations: [
      {
        stage: 'e2',
        label: 'E2 · LP institucional',
        href: institutionalComparison,
      },
      {
        stage: 'e3_article',
        label: 'E3 · Artigo metodológico',
        href: methodologyArticle,
      },
      {
        stage: 'e3_registration',
        label: 'E3 · Cadastro com retorno à Rodada',
        href: registrationWithRoundReturn,
      },
    ],
    suppression: 'E1, calendário, jogos e introdução da Rodada.',
  },
  {
    state: 'viewed_blog',
    label: 'Viu Blog',
    treatment: 'deepening',
    message: 'E1 → Hub; E2 → LP; E3 retorna ao artigo.',
    destinations: [
      { stage: 'e1', label: 'E1 · Hub', href: hubDeepening },
      {
        stage: 'e2',
        label: 'E2 · LP institucional',
        href: institutionalComparison,
      },
      {
        stage: 'e3',
        label: 'E3 · Retornar ao artigo',
        href: methodologyArticle,
      },
    ],
    suppression: 'Apresentação genérica do Blog.',
  },
  {
    state: 'viewed_hub',
    label: 'Viu Hub',
    treatment: 'deepening',
    message: 'E1 → Rodada; E2 → LP; E3 → artigo.',
    destinations: [
      { stage: 'e1', label: 'E1 · Rodada', href: roundOverview },
      {
        stage: 'e2',
        label: 'E2 · LP institucional',
        href: institutionalComparison,
      },
      {
        stage: 'e3',
        label: 'E3 · Artigo',
        href: methodologyArticle,
      },
    ],
    suppression: 'Apresentação do Hub.',
  },
  {
    state: 'never_viewed',
    label: 'Nunca viu',
    treatment: 'discovery',
    message: 'E1 → Hub; E2 → LP institucional; E3 → artigo.',
    destinations: [
      { stage: 'e1', label: 'E1 · Hub', href: hubOverview },
      {
        stage: 'e2',
        label: 'E2 · LP institucional',
        href: institutionalComparison,
      },
      {
        stage: 'e3',
        label: 'E3 · Blog',
        href: methodologyArticle,
      },
    ],
    suppression: 'Nenhuma além do cap.',
  },
];

const renderedPriority = JOURNEY_PRIORITY.map(
  (state) => matrixRows.find((row) => row.state === state)?.label,
).filter(Boolean);
---

<section class="campaign-panel campaign-priority-note">
  <p class="eyebrow">Regra de coordenação</p>
  <h2>Bloco 8 roda em paralelo e tem prioridade</h2>
  <p>
    Esta jornada não repete calendário, jogos, placares, matchday nem conteúdo
    semanal. Se o ciclo da rodada ocupar a janela, a mensagem da waitlist é adiada
    e recalculada.
  </p>
</section>

<section class="campaign-panel" aria-labelledby="journey-priority-title">
  <p class="eyebrow">Prioridade determinística · {renderedPriority.length} estados</p>
  <h2 id="journey-priority-title">Estado vencedor antes de cada envio</h2>
  <p class="journey-priority">
    Abandono &gt; Gate &gt; 2+ &gt; Rodada &gt; Blog &gt; Hub &gt; Nunca viu
  </p>
  <p class="supporting-copy">
    No mesmo nível, vence o evento mais recente. Em empate, a ordem é início de
    cadastro, clique no teaser, engajamento e visualização.
  </p>
</section>

<section class="campaign-panel" aria-labelledby="journey-matrix-title">
  <p class="eyebrow">Decisão por comportamento</p>
  <h2 id="journey-matrix-title">Matriz dos sete estados</h2>
  <div class="journey-matrix-scroll" tabindex="0" aria-label="Matriz comportamental com rolagem horizontal">
    <table class="journey-matrix" data-journey-matrix>
      <thead>
        <tr>
          <th>Estado vencedor</th>
          <th>Tratamento</th>
          <th>Mensagem e destino</th>
          <th>Supressão</th>
        </tr>
      </thead>
      <tbody>
        {matrixRows.map((row) => (
          <tr data-journey-state={row.state}>
            <th scope="row">{row.label}</th>
            <td><code>{row.treatment}</code></td>
            <td>
              <span>{row.message}</span>
              <span class="journey-destinations">
                {row.destinations.map((destination) => (
                  <a
                    data-journey-destination={destination.stage}
                    href={destination.href}
                  >
                    {destination.label}
                  </a>
                ))}
              </span>
            </td>
            <td data-journey-suppression>{row.suppression}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>

<section class="campaign-panel" aria-labelledby="variant-title">
  <p class="eyebrow">Variações editoriais</p>
  <h2 id="variant-title">Descoberta, aprofundamento e recuperação</h2>
  <div class="variant-grid">
    <article>
      <span>discovery</span>
      <h3>Descoberta</h3>
      <p>Apresenta somente a próxima superfície útil ainda não vista.</p>
    </article>
    <article>
      <span>deepening</span>
      <h3>Aprofundamento</h3>
      <p>Reconhece o que já foi visto e avança sem repetir a introdução.</p>
    </article>
    <article>
      <span>gate_recovery · registration_recovery</span>
      <h3>Recuperações</h3>
      <p>Substituem mensagens regulares e ocupam os slots restantes do mesmo teto.</p>
    </article>
  </div>
</section>

<section class="campaign-panel frequency-cap" data-frequency-cap aria-labelledby="frequency-cap-title">
  <p class="eyebrow">Recência e controle de pressão</p>
  <h2 id="frequency-cap-title">Limites globais</h2>
  <div class="cap-grid">
    <article><strong>{RECENCY_DAYS} dias</strong><span>janela comportamental</span></article>
    <article><strong>{FREQUENCY_CAP.marketingPer24Hours} marketing / 24h</strong><span>todas as campanhas</span></article>
    <article><strong>{FREQUENCY_CAP.marketingPer7Days} / 7 dias</strong><span>máximo de marketing</span></article>
    <article><strong>&gt;{FREQUENCY_CAP.staleAfterHours}h</strong><span>recalcular ou descartar</span></article>
    <article><strong>{FREQUENCY_CAP.maxJourneyMessages}</strong><span>máximo vitalício da jornada</span></article>
  </div>
  <p class="cap-priority">
    {FREQUENCY_CAP.block8HasPriority
      ? 'Bloco 8 tem prioridade; a waitlist nunca amplia o teto.'
      : 'A jornada segue o cap global.'}
  </p>
</section>

<section class="campaign-panel exit-flow" aria-labelledby="exit-rules-title">
  <p class="eyebrow">Saída imediata</p>
  <h2 id="exit-rules-title">Nenhuma mensagem pendente sobrevive ao encerramento</h2>
  <ul>
    <li><b>Cadastro concluído:</b> cancela regulares e recuperações, preserva atribuição e inicia onboarding.</li>
    <li><b>Opt-out:</b> encerra a jornada antes do próximo cálculo.</li>
    <li><b>Bounce definitivo:</b> bloqueia novos envios de marketing.</li>
    <li><b>Reclamação:</b> encerra a jornada e impede reentrada.</li>
  </ul>
</section>
