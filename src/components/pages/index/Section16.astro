        <div class="spark"><s style="height:48%"></s><s style="height:50%"></s><s style="height:48%"></s><s style="height:54%"></s><s style="height:70%"></s><s style="height:80%"></s><s class="hi" style="height:100%"></s></div>
        <div style="display:flex;justify-content:space-between;font-size:10px;color:var(--muted);margin-top:3px"><span>ter 41%</span><span>hoje 47%</span></div>
