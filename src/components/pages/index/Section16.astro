    <div class="h2r wl"><div class="v">8,4</div><div class="h2b l"><s style="width:84%"></s></div><div class="lb">Momento</div><div class="h2b r"><s style="width:61%"></s></div><div class="v r">6,1</div></div>
    <div class="h2r wl"><div class="v">8,1</div><div class="h2b l"><s style="width:81%"></s></div><div class="lb">Ataque</div><div class="h2b r"><s style="width:74%"></s></div><div class="v r">7,4</div></div>
    <div class="h2r wl"><div class="v">8,6</div><div class="h2b l"><s style="width:86%"></s></div><div class="lb">Defesa</div><div class="h2b r"><s style="width:58%"></s></div><div class="v r">5,8</div></div>
