  <tbody><tr>
    <th style="width:100px">Peça</th><th style="width:130px">Gatilho</th><th>E-mail</th><th>Landing (tema / foco)</th>
  </tr>
  <tr>
    <td><b>E-mail 1</b><br>Boas-vindas</td>
    <td>Imediato</td>
