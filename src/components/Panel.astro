---
interface Props {
  tone?: 'default' | 'premium';
}

const { tone = 'default' } = Astro.props;
---

<section
  class:list={[
    'rounded-[var(--radius-card)] border p-4',
    tone === 'premium'
      ? 'border-[var(--border-subtle)] bg-[var(--canvas-premium)] text-[var(--text-body)]'
      : 'border-[var(--surface-accent)] bg-[var(--surface)] text-[var(--text-body)]',
  ]}
  data-panel-tone={tone}
>
  <slot />
</section>
